{
  "name": "fridgetwin",
  "version": "1.0.0",
  "description": "A digital twin of your fridge. Scan barcodes, track best-before dates, and cook from what you have at home.",
  "license": "MIT",
  "author": "Emre Sunar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emsurenar/FridgeTwin.git"
  },
  "homepage": "https://fridge-twin.vercel.app",
  "bugs": {
    "url": "https://github.com/Emsurenar/FridgeTwin/issues"
  },
  "keywords": [
    "pwa",
    "food-waste",
    "barcode",
    "fridge",
    "open-food-facts",
    "anthropic"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"PORT=8799 node --env-file-if-exists=.env server.js\" \"vite\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@libsql/client": "^0.17.4",
    "express": "^5.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
