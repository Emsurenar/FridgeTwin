# Kopiera till .env och fyll i. Inget av det här behövs för att köra lokalt —
# utan konfiguration används en SQLite-fil i data/.

# Beständig lagring. Utan den bor lagret i serverns /tmp, och på Vercel är den
# katalogen per instans — varor ser då ut att försvinna. Se README.
TURSO_URL=
TURSO_TOKEN=

# Anthropic-nyckeln står inte här, och ska inte göra det.
#
# AI-nyckeln är privat per enhet: var och en lägger in sin egen under
# Inställningar → AI, och den går direkt från webbläsaren till Anthropic utan
# att passera den här servern. En nyckel i serverns miljö hade betytt att alla
# som hittar deployen spenderar ur samma plånbok.
#
# Sätt ändå en spendgräns på din nyckel hos Anthropic — det är det enda som
# faktiskt begränsar kostnaden.
