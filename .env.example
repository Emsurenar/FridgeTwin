# Kopiera till .env och fyll i. Inget av det här behövs för att köra lokalt —
# utan konfiguration används en SQLite-fil i data/ och AI-funktionerna är av.

# Beständig lagring. Utan den bor lagret i serverns /tmp, och på Vercel är den
# katalogen per instans — varor ser då ut att försvinna. Se README.
TURSO_URL=
TURSO_TOKEN=

# Serverns Anthropic-nyckel. Sätts den går AI-anropen via /api/ai och nyckeln
# stannar på servern. Utan den kan varje användare lägga in sin egen nyckel
# under Inställningar.
# Sätt en spendgräns på nyckeln hos Anthropic — det är det enda som faktiskt
# begränsar kostnaden.
ANTHROPIC_API_KEY=

# Kommaseparerad lista över tillåtna origins för /api/ai. Ligger serverns
# Anthropic-nyckel i miljön SKA den här sättas, annars kan vem som helst som
# hittar din deploy spendera din budget.
ALLOWED_ORIGINS=

# Antal AI-anrop per IP per 5 minuter. Standard 20.
AI_RATE_LIMIT=
